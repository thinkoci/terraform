# The profile must exist in ~/.oci/config.
oci_profile = "DEFAULT"

# Recommended: deploy into a child compartment instead of the tenancy root.
# If omitted, the tenancy OCID is read from ~/.oci/config and used as the compartment.
# compartment_ocid = "ocid1.compartment.oc1..example"

project_name = "thinkoci-ci-demo"

# Restrict this to your public IP for a private demo, for example "203.0.113.10/32".
allowed_cidr = "0.0.0.0/0"

# Change the shape if E4 capacity is unavailable in your region.
# container_instance_shape = "CI.Standard.E5.Flex"
# container_instance_shape = "CI.Standard.A1.Flex"

ocpus        = 1
memory_in_gbs = 2
